# One: centraliza empresas, usuarios y configuración. El login se pide aquí, no al
# API de actas, que solo verifica los tokens que One firma.
VITE_ONE_URL=https://intechsys-one-api-b5b5a6cbf9emevev.centralus-01.azurewebsites.net
